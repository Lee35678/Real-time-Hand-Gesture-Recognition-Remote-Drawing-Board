# 민감 정보 / 배포 토폴로지 전용 (refactoring.md Pillar 1-1).
#
# 튜닝 가능한 임계값(제스처 각도, 줌 비율, 캔버스 크기 등)은 여기가 아니라
# config/{service}.yaml + config/{service}.{dev,prod}.yaml에 있다. 이 파일은
# "커밋하면 안 되는 값"(토큰)과 "환경마다 달라지는 값"(공개 URL, 서비스 간 주소)만
# 다룬다.
#
# 사용법: 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 .gitignore에 있어
# 커밋되지 않는다. docker compose는 이 디렉터리의 `.env`를 자동으로 읽어
# docker-compose.yml의 `${VAR}` 치환에 사용한다.
#
#   cp .env.example .env

# --- 필수: 운영 배포 시 반드시 기본값을 교체할 것 ---

# Container A(web)의 세션 토큰. 기본값 "hand-board"는 이 저장소 소스에 그대로
# 적혀 있으므로 사실상 공개된 값이다 — APP_ENV=prod에서 이 값을 그대로 두면
# 컨테이너가 기동을 거부한다 (containers/web/app.py의 Fail-Fast 체크 참고).
SESSION_TOKEN=hand-board

# 휴대폰에서 접속할 공개 HTTPS 주소 (ngrok 등 터널링 도구가 발급한 주소).
# 비워두면 QR 코드가 상대 경로 기준으로 생성되어 PC 로컬 접속에는 문제없지만,
# 원격(휴대폰) 접속 시 QR이 가리키는 주소가 달라질 수 있다.
PUBLIC_BASE_URL=

# --- 선택: docker-compose가 아니라 로컬에서 컨테이너를 직접 실행할 때만 필요 ---
#
# 아래 4개는 docker-compose.yml에도 있지만 각 서비스의 `environment:` 블록에
# 이미 docker-compose 네트워크 기준 값으로 하드코딩되어 있다 — `.env`에 채워도
# `docker compose up`에는 반영되지 않는다(compose는 `${VAR}` 치환 문법을 쓴 곳만
# .env를 읽는다). Docker 없이 각 서비스를 `python -m app.main` / `uvicorn`으로
# 직접 띄울 때, 또는 compose 밖의 다른 네트워크 토폴로지에 배포할 때만 채운다.

# Container A -> B (vision-analysis) ingest 주소.
# VISION_ANALYSIS_WS_URL=ws://vision-analysis:8760/ingest/{session_id}

# Container B -> C (pattern-command) 랜드마크 패킷 주소.
# PATTERN_COMMAND_WS_URL=ws://pattern-command:8761/landmarks

# Container C -> D (canvas) 명령 주소.
# CANVAS_WS_URL=ws://canvas:8762/commands/{session_id}

# Container D -> A 캔버스 프레임 회신 주소.
# WEB_CANVAS_OUTPUT_URL=ws://web:8000/ws/canvas-output/{session_id}

# --- 선택: 로컬 직접 실행(Docker 없이) 시에만 필요 ---

# dev | prod. Docker 이미지는 각 Dockerfile이 이미 prod로 고정한다 — 이 값은
# `python -m app.main` 등으로 컨테이너 없이 직접 실행할 때만 의미가 있다.
# prod로 두면 위 SESSION_TOKEN 등 Fail-Fast 검증이 활성화된다.
# APP_ENV=dev

# MediaPipe Hand Landmarker 모델 파일 경로 (vision-analysis). Docker 이미지는
# 빌드 시점에 다운로드해 자동으로 채운다 — 로컬 직접 실행 시에만 필요.
# HAND_LANDMARKER_MODEL_PATH=containers/vision-analysis/models/hand_landmarker.task
